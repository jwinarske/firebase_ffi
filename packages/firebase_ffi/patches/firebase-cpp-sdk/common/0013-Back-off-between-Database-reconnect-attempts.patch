From: Joel Winarske <joel.winarske@linux.com>
Subject: [PATCH] Back off between Database reconnect attempts

TryScheduleReconnect scheduled the next attempt with no delay, and every
failure came back to it.  A server that can't be reached was retried about
5,700 times a second.  A token that can't be fetched, as when a restored
session's refresh token is refused, sent about 2,300 refresh requests a
second.  The writes waiting on the connection never fail, so it runs until
the app quits.

Wait between attempts, as the Android SDK's RetryHelper does: 1s, then 1.3
times longer each time up to 30s, jittered.  The first attempt after a
connection that stayed up 30s, and the first after a resume, runs at once.
Interrupt cancels the attempt that is waiting.  An attempt that wakes to find
the connection interrupted or not disconnected does nothing.
---
 database/src/desktop/connection/persistent_connection.cc | 73 ++++++++++++++++++++++++++----
 database/src/desktop/connection/persistent_connection.h  |  8 ++++
 2 files changed, 73 insertions(+), 8 deletions(-)

diff --git a/database/src/desktop/connection/persistent_connection.cc b/database/src/desktop/connection/persistent_connection.cc
index 5e2ef2e..bcb0162 100644
--- a/database/src/desktop/connection/persistent_connection.cc
+++ b/database/src/desktop/connection/persistent_connection.cc
@@ -17,6 +17,7 @@
 #include <algorithm>
 #include <cassert>
 #include <cstdint>
+#include <random>
 #include <sstream>
 #include <utility>
 
@@ -92,6 +93,26 @@ const char* PersistentConnection::kServerResponseData = "d";
 
 int PersistentConnection::kInvalidAuthTokenThreshold = 3;
 
+namespace {
+
+// Reconnect backoff, as the Android SDK's RetryHelper has it. The first attempt
+// after a connection that lasted runs at once. Each one after that waits
+// longer, up to the maximum, and the wait is jittered so that clients dropped
+// together don't come back together.
+constexpr uint64_t kReconnectMinDelayMs = 1000;
+constexpr uint64_t kReconnectMaxDelayMs = 30000;
+constexpr double kReconnectMultiplier = 1.3;
+constexpr double kReconnectJitter = 0.7;
+// A connection that was up this long counts as a success.
+constexpr uint64_t kReconnectResetMs = 30000;
+
+double RandomFraction() {
+  static thread_local std::mt19937 engine{std::random_device{}()};
+  return std::uniform_real_distribution<double>(0.0, 1.0)(engine);
+}
+
+}  // namespace
+
 std::atomic<uint32_t> PersistentConnection::next_log_id_(0);
 
 // Util function to print QuerySpec in debug logs.
@@ -114,6 +135,9 @@ PersistentConnection::PersistentConnection(
       realtime_(nullptr),
       connection_state_(kDisconnected),
       is_first_connection_(true),
+      reconnect_delay_ms_(0),
+      last_connection_succeeded_(true),
+      connection_established_ms_(0),
       invalid_auth_token_count(0),
       next_request_id_(0),
       force_auth_refresh_(false),
@@ -186,6 +210,7 @@ void PersistentConnection::OnReady(int64_t timestamp,
   SAFE_REFERENCE_RETURN_VOID_IF_INVALID(ThisRefLock, lock, safe_this_);
 
   logger_->LogDebug("%s OnReady", log_id_.c_str());
+  connection_established_ms_ = ::firebase::internal::GetTimestampEpoch();
 
   // Trigger OnServerInfoUpdate based on timestamp delta
   logger_->LogDebug("%s Handle timestamp: %lld in ms", log_id_.c_str(),
@@ -317,6 +342,13 @@ void PersistentConnection::OnDisconnect(Connection::DisconnectReason reason) {
 
   CancelSentTransactions();
 
+  if (connection_established_ms_ != 0 &&
+      ::firebase::internal::GetTimestampEpoch() - connection_established_ms_ >
+          kReconnectResetMs) {
+    last_connection_succeeded_ = true;
+  }
+  connection_established_ms_ = 0;
+
   if (ShouldReconnect()) {
     TryScheduleReconnect();
   }
@@ -492,12 +524,11 @@ void PersistentConnection::InterruptInternal(InterruptReason reason) {
     realtime_->Close();
     realtime_.reset(nullptr);
   } else {
-    // TODO(chkuang): Implement Retry
-    // retryHelper.cancel();
+    if (reconnect_request_.IsValid()) reconnect_request_.Cancel();
     connection_state_ = kDisconnected;
   }
-  // TODO(chkuang): Implement Retry
-  // retryHelper.signalSuccess();
+  // The next attempt, on resume, runs at once.
+  last_connection_succeeded_ = true;
 }
 
 void PersistentConnection::ResumeInternal(InterruptReason reason) {
@@ -519,14 +550,38 @@ void PersistentConnection::TryScheduleReconnect() {
   FIREBASE_DEV_ASSERT(connection_state_ == kDisconnected);
   bool force_refresh = force_auth_refresh_;
   force_auth_refresh_ = false;
-  logger_->LogDebug("%s Scheduling connection attempt", log_id_.c_str());
 
-  scheduler_->Schedule(new callback::CallbackValue2<ThisRef, bool>(
+  // Without a wait, a token that can't be fetched or a server that can't be
+  // reached was retried as fast as the scheduler could run it.
+  uint64_t delay_ms = 0;
+  if (last_connection_succeeded_) {
+    reconnect_delay_ms_ = 0;
+  } else {
+    const auto last = static_cast<double>(reconnect_delay_ms_);
+    reconnect_delay_ms_ =
+        reconnect_delay_ms_ == 0
+            ? kReconnectMinDelayMs
+            : std::min(static_cast<uint64_t>(last * kReconnectMultiplier),
+                       kReconnectMaxDelayMs);
+    const auto next = static_cast<double>(reconnect_delay_ms_);
+    delay_ms =
+        static_cast<uint64_t>(next * (1.0 - kReconnectJitter) +
+                              next * kReconnectJitter * RandomFraction());
+  }
+  last_connection_succeeded_ = false;
+  logger_->LogDebug("%s Scheduling connection attempt in %llu ms",
+                    log_id_.c_str(), static_cast<unsigned long long>(delay_ms));
+
+  auto* attempt = new callback::CallbackValue2<ThisRef, bool>(
       safe_this_, force_refresh, [](ThisRef ref, bool force_refresh) {
         ThisRefLock lock(&ref);
         auto* connection = lock.GetReference();
         if (!connection) return;
-        // TODO(chkuang): Implement Exponential Backoff Retry
+        // Interrupted, or connected some other way, while it waited.
+        if (!connection->ShouldReconnect() ||
+            connection->connection_state_ != kDisconnected) {
+          return;
+        }
         connection->connection_state_ = kGettingToken;
         connection->logger_->LogDebug("%s Trying to fetch auth token",
                                       connection->log_id_.c_str());
@@ -584,7 +639,9 @@ void PersistentConnection::TryScheduleReconnect() {
           connection->app_check_token_.clear();
           connection->OpenNetworkConnection();
         }
-      }));
+      });
+  if (reconnect_request_.IsValid()) reconnect_request_.Cancel();
+  reconnect_request_ = scheduler_->Schedule(attempt, delay_ms);
 }
 
 void PersistentConnection::OnAuthTokenFutureComplete(
diff --git a/database/src/desktop/connection/persistent_connection.h b/database/src/desktop/connection/persistent_connection.h
index 09da1ac..de2b844 100644
--- a/database/src/desktop/connection/persistent_connection.h
+++ b/database/src/desktop/connection/persistent_connection.h
@@ -527,6 +527,14 @@ class PersistentConnection : public ConnectionEventHandler {
   ConnectionState connection_state_;
   bool is_first_connection_;
 
+  // Reconnect backoff. The attempt waiting to run, the delay the last one
+  // waited, whether the connection before it counted as a success, and when the
+  // current connection became ready.
+  scheduler::RequestHandle reconnect_request_;
+  uint64_t reconnect_delay_ms_;
+  bool last_connection_succeeded_;
+  uint64_t connection_established_ms_;
+
   // Session
   std::string last_session_id_;
 
